     ]
    },
    {
     "id": "decline_stay",
     "label": "算了，留下来练自己的",
     "desc": "「谢谢想到我，但这周我们团有安排。」我回得很快，快得像在说服自己。",
     "immediate": {
      "stage": 3,
      "relation_all": 4,
      "psyche": -3
     },
     "delayed": []
