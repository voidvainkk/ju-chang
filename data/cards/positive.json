        {
          "id": "share_it",
          "label": "和她分着唱",
          "desc": "「这本来是你的歌，一人一半。」我把谱子往她那边推了推。",
          "immediate": {
            "stage": 2,
            "relation_A": 8,
            "relation_B": 3,
            "fame": 1,
