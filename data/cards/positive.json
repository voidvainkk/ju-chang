{
  "_meta": {
    "category": "positive",
    "desc": "好事卡（有选项）：舞台、人气、钱、关系往好里走的机会。仍然两难——两个选项各拿各的好，你只能挑一样：要钱还是要人、要曝光还是要稳。不会有'全拿'的选项。用来平衡卡池，让一季不只有坏消息。",
    "resource_keys": {
      "fame": "人气",
      "money": "钱",
      "stage": "舞台稳定",
      "stamina": "体力",
      "psyche": "心理",
      "ota_all": "全体OTA黏性",
      "relation_A": "阿棠",
      "relation_B": "露露",
      "relation_C": "小满",
      "enjou": "炎上（越高越糟）",
      "banzi": "板子关注度",
      "kaibox": "开盒风险（越高越糟）",
      "shiroi": "私生跟踪值（越高越糟）"
    },
    "casting_schema": "card.casting = [ {slot, select:{gender?/fan_type?/archetype?/min_stickiness?/private_contact?}, allow_hatch} ]；narrative/label/desc 用 {{slot}} 显示名字、{{slot.ta}} 显示他/她；effect 键 @<slot> = 投给该槽位选中 OTA 的黏性增减，ota_all 仍为全体；无符合条件者且 allow_hatch 时按原型孵化新人填入。"
  },
  "cards": [
    {
